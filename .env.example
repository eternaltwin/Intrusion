# Configuration Serveur & OAuth Eternaltwin — Intrusion
# Copiez ce fichier vers `.env` (jamais versionné) et adaptez les valeurs.

# Environnement d'exécution ('development' ou 'production')
NODE_ENV=development

# Port HTTP d'écoute du serveur Node/Hono
PORT=8001

# Chemin du fichier SQLite (relatif ou absolu)
DB_PATH=./data/intrusion.sqlite

# URL publique canonique vue par le navigateur :
# - En dev (`npm run dev`, Vite sur 5173 qui proxy `/api` vers 8001) : http://localhost:5173
# - En prod (`npm start`) : https://intrusion.eternaltwin.org (ou http://localhost:8001)
PUBLIC_URL=http://localhost:5173

# Lien public vers le dépôt du code source affiché dans l'interface (clause AGPLv3 §13)
SOURCE_REPO_URL=https://github.com/eternaltwin/intrusion

# --- Authentification OAuth 2.0 Eternaltwin (Obligatoire en production) ---
# URL interne/API du serveur Eternaltwin :
# - Serveur local `@eternaltwin/cli` : http://localhost:50320
# - Serveur officiel Eternaltwin     : https://eternaltwin.org
ETWIN_URL=http://localhost:50320
# URL publique Eternaltwin vue par le navigateur (par défaut identique à ETWIN_URL)
ETWIN_EXTERNAL_URL=http://localhost:50320
# Identifiant (ex: `intrusion@clients` ou UUID) et secret du client OAuth
ETWIN_CLIENT_ID=intrusion@clients
ETWIN_CLIENT_SECRET=dev_secret
# URI exacte de redirection OAuth enregistrée côté Eternaltwin
ETWIN_CALLBACK_URL=http://localhost:5173/api/auth/etwin/callback
# Scope OAuth Eternaltwin
ETWIN_OAUTH_SCOPE=base

# Autoriser le simulateur d'identité hors-ligne sans mot de passe en développement local uniquement
# (Toujours ignoré et forcé à false lorsque NODE_ENV=production)
ETWIN_DEV_AUTH=true
