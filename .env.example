# Configuration Serveur, PostgreSQL & OAuth Eternaltwin — Intrusion
# Compatible nativement avec les variables générées par Katal (Eternaltwin).
# Copiez ce fichier vers `.env` (jamais versionné) et adaptez les valeurs.

NODE_ENV=development
APP_ENV=development

# Port HTTP d'écoute du serveur Node/Hono (et hôte optionnel, ex: HOST=127.0.0.1)
PORT=8001
# HOST=127.0.0.1

# URL publique canonique de l'application (convention Katal : SELF_URL / SELF_API_URL) :
# - En dev (`npm run dev`, Vite sur 5173 qui proxy `/api` vers 8001) : http://localhost:5173/
# - En prod / staging via Katal                                      : https://intrusion.eternaltwin.org/
SELF_URL=http://localhost:5173/
SELF_API_URL=http://localhost:5173/

# Lien public vers le dépôt du code source affiché dans l'interface (clause AGPLv3 §13)
SOURCE_REPO_URL=https://github.com/eternaltwin/intrusion

# --- Authentification OAuth 2.0 Eternaltwin (Obligatoire en production) ---
# - Serveur local `@eternaltwin/cli` : http://localhost:50320/
# - Serveur officiel Eternaltwin     : https://eternaltwin.org/ (ou https://staging.eternaltwin.org/)
ETERNALTWIN_URL=http://localhost:50320/
# Optionnel si l'URL navigateur diffère de ETERNALTWIN_URL :
# ETERNALTWIN_EXTERNAL_URL=http://localhost:50320/
ETERNALTWIN_CLIENT_ID=intrusion@clients
ETERNALTWIN_CLIENT_SECRET=dev_secret
# Optionnel : calculé automatiquement depuis `${SELF_URL}/api/auth/eternaltwin/callback` si omis
# ETERNALTWIN_CALLBACK_URL=http://localhost:5173/api/auth/eternaltwin/callback
ETERNALTWIN_OAUTH_SCOPE=base

# --- Base de données PostgreSQL (Obligatoire en production) ---
# Priorité 1 : URL complète générée par Katal (les paramètres ?version=17&charset=utf8 sont supportés)
DATABASE_URL=postgresql://intrusion:intrusion@localhost:5432/intrusion?version=17&charset=utf8

# Priorité 2 : Variables séparées Katal (utilisées automatiquement si DATABASE_URL est absent)
DATABASE_NAME=intrusion
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=intrusion
DATABASE_PASSWORD=intrusion

# Note développement local hors-ligne sans démon PostgreSQL installé :
# En NODE_ENV=development uniquement, `DATABASE_URL=pglite://./data/pgdata` utilise
# le moteur PostgreSQL embarqué PGlite sur disque local (strictement bloqué en production).

# Autoriser le simulateur d'identité hors-ligne sans mot de passe en développement local uniquement
# (Toujours ignoré et forcé à false lorsque NODE_ENV=production ou APP_ENV=production)
ETERNALTWIN_DEV_AUTH=true
