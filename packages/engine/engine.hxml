-resource ../../legacy/xml/fsNames.en.xml@xml_fsNames_en
-resource ../../legacy/xml/names.en.xml@xml_names_en
-resource ../../legacy/xml/tutorials.en.xml@xml_tutorials_en
-resource ../../legacy/xml/texts.en.xml@xml_texts_en
-resource ../../legacy/xml/virus.en.xml@xml_virus_en
