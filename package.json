{
  "name": "intrusion-cyberdeck",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@intrusion/shared",
    "build:client": "npm run build --workspace=@intrusion/client",
    "build:server": "npm run build --workspace=@intrusion/server",
    "build": "npm run build:shared && npm run build:client && npm run build:server",
    "dev": "npm run build:shared && concurrently -n shared,server,client -c cyan,green,yellow \"npm run dev --workspace=@intrusion/shared\" \"npm run dev --workspace=@intrusion/server\" \"npm run dev --workspace=@intrusion/client\"",
    "start": "node packages/server/dist/index.js",
    "test": "vitest run -c vitest.config.mjs --configLoader native",
    "test:watch": "vitest -c vitest.config.mjs --configLoader native"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
